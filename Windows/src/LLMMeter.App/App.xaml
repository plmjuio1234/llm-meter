<Application
    x:Class="LLMMeter.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#071A3D" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0D224A" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#112B58" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#23477D" />
            <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#1FD7E8" />
            <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#9B6CFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F8FF" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AFC3E2" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#7892B8" />
            <SolidColorBrush x:Key="FreshBrush" Color="#55D6A0" />
            <SolidColorBrush x:Key="StaleBrush" Color="#F0B85B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF8A8A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
